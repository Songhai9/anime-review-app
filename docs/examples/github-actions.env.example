# GitHub Actions settings for anime-review-app (.github/workflows/ci.yml).
# CHECKLIST ONLY: the workflow does not read this file. Never commit real values.

# Settings → Secrets and variables → Actions → Secrets
# Fine-grained PAT, repository access: anime-review-k8s only,
# permission "Actions: Read and write" (dispatch deploy.yml + read its run status).
K8S_WORKFLOW_TOKEN=github_pat_REPLACE_ME

# Nothing else to create:
#  - GITHUB_TOKEN (built-in) pushes the images, thanks to `permissions: packages: write` on the build job
#  - test database values are defined inside the workflow for the postgres:16-alpine service

# After the first run: Profile → Packages → anime-review-backend / anime-review-frontend
#  → Package settings → Change visibility → Public
#  (or create a ghcr.io pull Secret in the cluster, see anime-review-k8s README)
