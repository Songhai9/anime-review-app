# GitLab CI/CD settings for the anime-review-app project.
# CHECKLIST ONLY: the pipeline does not read this file.

# No custom variable is required. GitLab provides:
#   CI_REGISTRY, CI_REGISTRY_IMAGE, CI_REGISTRY_USER, CI_REGISTRY_PASSWORD, CI_COMMIT_SHORT_SHA
# Test database values (DATABASE_*, TEST_DATABASE_URL) are defined inside .gitlab-ci.yml
# for the throw-away postgres:16-alpine service; they are not secrets.

# Edit in .gitlab-ci.yml if your project paths differ:
#   trigger_k8s.trigger.project = anilist-cicd/anilist-k8s         (phase 3)
#   trigger_infra.trigger.project = anilist-cicd/anilist-infra     (phase 2b archive)

# Project settings:
#   - Settings → General → Visibility: Container registry enabled
#   - A runner with privileged Docker-in-Docker (docker:24.0.5-dind + tonistiigi/binfmt)
#   - Settings → Repository → Deploy tokens: create one with read_registry
#       phase 2b → store it in the infra Ansible Vault (vault_registry_username / _password)
#       phase 3  → create the gitlab-registry Secret in the cluster (k8s README)
#   - In the TARGET project (k8s or infra): Settings → CI/CD → Job token permissions → allow this project
